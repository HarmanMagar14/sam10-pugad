{
  "agent": { "run_as_user": "root" },
  "logs": { "logs_collected": { "files": { "collect_list": [
    { "file_path": "/var/log/pugad/access.log", "log_group_name": "/sam10/pugad/requests",
      "log_stream_name": "{instance_id}", "retention_in_days": 30 },
    { "file_path": "/var/log/pugad/backup.log", "log_group_name": "/sam10/pugad/backup",
      "log_stream_name": "{instance_id}", "retention_in_days": 30 }
  ] } } },
  "metrics": {
    "namespace": "SAM10",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem":  { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"], "drop_device": true }
    }
  }
}
