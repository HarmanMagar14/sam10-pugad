log_format sam10 escape=json '{"time":"$time_iso8601","method":"$request_method",'
  '"path":"$uri","status":$status,"duration_s":$request_time,'
  '"version":"${APP_VERSION}","question":"$request_body"}';

server {
  listen 80;
  client_max_body_size 25m;
  client_body_buffer_size 64k;
  access_log /var/log/pugad/access.log sam10;

  location / {
    proxy_pass http://api:3080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_buffering off;
    proxy_read_timeout 300s;
  }
}
